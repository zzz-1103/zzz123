# 复制本文件为 .env，填好后只在本地用；部署到 Render 时把这些填进环境变量。
# 千万别把真实 .env 提交到 GitHub！

# 数据库连接串（Neon 免费数据库，形如 postgres://...）
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# DeepSeek API key（藏在后端，绝不再出现在前端）
DEEPSEEK_API_KEY=sk-把真实key填这里

# 管理后台密码（你自己登录查看聊天记录用）
ADMIN_PASSWORD=改成你自己的密码

# 允许访问后端的前端域名（逗号分隔，一般不用改）
ALLOWED_ORIGIN=https://lindaiyu.netlify.app,http://localhost:3000,http://localhost:5500

# 可选：前后端之间的暗号，防止别人蹭你的后端。设了就在前端 index.html 的 APP_KEY 填一样的值
# APP_API_KEY=随便填一串难猜的

# 端口（本地调试用，云端不用管）
PORT=3000
